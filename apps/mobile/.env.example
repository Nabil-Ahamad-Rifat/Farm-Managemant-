# Copy to .env. Expo inlines EXPO_PUBLIC_* vars into the JS bundle at build
# time — never put a secret here, only the public API base URL.
#
# - iOS Simulator / web: http://localhost:3000 works.
# - Android Emulator: use http://10.0.2.2:3000 instead (localhost on the
#   emulator refers to the emulator itself, not your dev machine).
# - Physical device (Expo Go / dev client): use your dev machine's LAN IP,
#   e.g. http://192.168.1.23:3000 — `next dev` prints this under "Network".
EXPO_PUBLIC_API_URL="http://localhost:3000"
