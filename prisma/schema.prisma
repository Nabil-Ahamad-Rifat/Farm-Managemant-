generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  employees      Employee[]
  cows           Cow[]
  feedBatches    FeedBatch[]
  sales          Sale[]
  otherExpenses  OtherExpense[]
  otherIncomes   OtherIncome[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("owner")
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id          String    @id @default(cuid())
  name        String
  role        String
  email       String?
  phone       String?
  salary      Float     @default(0)
  joinDate    DateTime?
  status      String    @default("active")
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  salaryPayments SalaryPayment[]
}

model SalaryPayment {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount      Float
  periodMonth Int
  periodYear  Int
  note        String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Cow {
  id            String   @id @default(cuid())
  tagNumber     String
  name          String
  breed         String?
  purchasePrice Float?
  status        String   @default("active")
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sales         Sale[]

  @@unique([tagNumber, tenantId])
}

model FeedBatch {
  id                String      @id @default(cuid())
  name              String
  quantity          Float
  unitPrice         Float
  remainingQuantity Float
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  usages FeedUsage[]
}

model FeedUsage {
  id          String    @id @default(cuid())
  feedBatchId String
  feedBatch   FeedBatch @relation(fields: [feedBatchId], references: [id], onDelete: Cascade)
  quantity    Float
  usedAt      DateTime  @default(now())
  note        String?
  createdAt   DateTime  @default(now())
}

model Sale {
  id            String   @id @default(cuid())
  customerName  String
  amount        Float
  status        String   @default("paid")
  saleType      String   @default("general")
  quantity      Float?
  unitPrice     Float?
  notes         String?
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  cowId         String?
  cow           Cow?     @relation(fields: [cowId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OtherExpense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String   @default("other")
  expenseDate DateTime @default(now())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OtherIncome {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String   @default("other")
  incomeDate  DateTime @default(now())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
